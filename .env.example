# Supabase (required for live catalog, checkout, admin)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay (add when ready - store works with COD only without these)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Transactional email (Resend) - order confirmations + status updates
# Free tier: https://resend.com
RESEND_API_KEY=
ORDER_FROM_EMAIL=The Jewel Nest <support@thejewelnest.co.in>
SUPPORT_EMAIL=support@thejewelnest.co.in
